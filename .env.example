# Environment configuration
# Copy this file to .env and fill in your values

# Flask
SECRET_KEY=your-secret-key-here
DEBUG=true

# MySQL（外部独立数据库）
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=zhiyuntai_cs

# Docker Hub（用于自动更新，不需要可不填）
DOCKER_USERNAME=your-dockerhub-username

# WeChat Work (企业微信)
WX_CORP_ID=your-corp-id
WX_AGENT_SECRET=your-agent-secret
WX_TOKEN=your-callback-token
WX_ENCODING_AES_KEY=your-aes-key

# Group Robot (群机器人)
WX_GROUP_ROBOT_TOKEN=your-robot-token
WX_GROUP_ROBOT_WEBHOOK_URL=your-robot-webhook-url

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key

# Admin auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
